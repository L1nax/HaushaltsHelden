rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Family-Dokumente + Push-Token-Subcollection sind offen für alle Clients,
    // die die familyId kennen. Das entspricht dem bestehenden Sync-Modell.
    match /families/{familyId} {
      allow read, write: if true;
      match /pushTokens/{tokenId} {
        allow read, write: if true;
      }
    }
  }
}
